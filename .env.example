# Baza de date. Local: fisier SQLite. In productie: Turso.
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=

# Secretul cu care se semneaza cookie-ul de sesiune (generat de `npm run pregatire`).
SECRET_SESIUNE=

# Notificari push (generate de `npm run pregatire`).
VAPID_CHEIE_PUBLICA=
VAPID_CHEIE_PRIVATA=
VAPID_CONTACT=mailto:hac.filip05@gmail.com

# Cheia cu care serviciul de cron are voie sa cheme /api/cron.
CHEIE_CRON=

# Ora la care pleaca rezumatul zilei, in ora Romaniei. Implicit 8.
ORA_REZUMAT=8

# Cont de serviciu Google, pentru bugetul din Sheets si calendarele Google.
# Partajeaza sheet-ul (Editor) si fiecare calendar (doar citire) cu adresa de mai jos.
GOOGLE_EMAIL_SERVICIU=
GOOGLE_CHEIE_PRIVATA=
BUGET_SHEET_ID=1PsVly2ypaJ04C22TjNJ7NIbkCZpUORYzMUKKPe5hLLQ
